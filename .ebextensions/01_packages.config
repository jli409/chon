# Elastic Beanstalk Python platforms install requirements.txt automatically during staging.
# Do NOT duplicate `pip install` in container_commands with leader_only: false — that re-runs
# the full install on every instance and can multiply deploy time with no extra benefit.

option_settings:
  aws:elasticbeanstalk:application:environment:
    # application.py and requirements.txt are at the repo root (not under backend/).
    PYTHONPATH: "/var/app/current:$PYTHONPATH"
    # Match gunicorn (Procfile uses $PORT) and any custom nginx under .platform/ that proxies to 5000.
    PORT: "5000"
    # Prefer wheels over sdist to avoid long compiles on small instances (add gcc in packages only if needed).
    PIP_PREFER_BINARY: "1"
    # Skip writing .pyc on import during boot (minor I/O savings on small volumes).
    PYTHONDONTWRITEBYTECODE: "1"
